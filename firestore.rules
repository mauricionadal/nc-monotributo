rules_version = '2';

// Cómo instalar estas reglas: Firebase Console → tu proyecto (nc-monotributo)
// → Firestore Database → pestaña "Reglas" → pegar este contenido → Publicar.

service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Cada documento de cliente tiene como ID el UID de su usuario de Firebase Auth.
    // Un cliente autenticado solo puede leer SU PROPIO documento. Nunca la colección completa.
    match /clientes_monotributo/{clientId} {
      allow read: if request.auth != null && (request.auth.uid == clientId || esAdmin());
      allow write: if request.auth != null && esAdmin();
    }

    // La colección "admins" identifica qué usuarios son administradores.
    // Se carga a mano desde la consola de Firebase (ver README) — nunca desde la app.
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false;
    }

    // Configuración general (por ejemplo, costo por adherente de obra social).
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && esAdmin();
    }
  }
}
